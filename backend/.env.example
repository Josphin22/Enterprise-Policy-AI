# Enterprise Policy AI - Environment Configuration Example

# Server
APP_NAME="Enterprise Policy RAG API"
HOST="0.0.0.0"
PORT=8000
DEBUG=True
LOG_LEVEL="INFO"

# CORS & Frontend
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Database Configuration (SQLite default; uncomment PostgreSQL if running via Docker)
DATABASE_URL="sqlite:///./enterprise_rag.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/enterprise_rag"

# Local LLM (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=4096
OLLAMA_MAX_TOKENS=1000

# Embedding & Vector Store Configurations
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
VECTOR_STORE_PATH="backend/vectorstore"
EMBEDDING_BATCH_SIZE=32

# Document Chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# RAG Retrieval Configurations
TOP_K=5
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.35
SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MAX_CONTEXT_CHARACTERS=6000

# Knowledge Base Automation
AUTO_REINDEX=true

