# ==============================================================================
# Enterprise Policy AI - Production Environment Variables Example
# Duplicate this file to .env before starting containers:
#   cp .env.example .env
# Never commit the .env file containing real secrets to version control.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=EnterpriseSecurePass2026!
POSTGRES_DB=enterprise_rag
POSTGRES_PORT=5432

# Production Frontend Port (Nginx HTTP)
FRONTEND_PORT=80
FRONTEND_URL=http://localhost

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=2
LOG_LEVEL=INFO
DEBUG=False

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173

# Authentication & JWT Security (Change this to a strong random 64-char key in production)
JWT_SECRET=EnterprisePolicySecretTokenKey2026ChangeMeInProd
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Seeded Enterprise Administrator Account
ADMIN_EMAIL=admin@enterprise.com
ADMIN_PASSWORD=Admin@Enterprise2026!

# Ollama LLM Settings
# In Docker: use http://host.docker.internal:11434 to connect to host Ollama
# On Linux Docker host without host-gateway: use http://172.17.0.1:11434
# If running containerized Ollama: use http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=4096

# Sentence Transformers Embedding & Vector Storage
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
VECTOR_STORE_PATH=/app/vectorstore
DOCUMENTS_DIR=/app/documents

# Chunking Parameters
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# RAG Retrieval Quality Settings
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHUNKS=5
RAG_MAX_CONTEXT_CHARACTERS=6000

# Security Guardrails & Safety Filtering
ENABLE_GUARDRAILS=true
ENABLE_SENSITIVE_DATA_SCRUB=true
MAX_ANSWER_TOKENS=600
MAX_ANSWER_CHARACTERS=3000
GROUNDING_SIMILARITY_THRESHOLD=0.45
